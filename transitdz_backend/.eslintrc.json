{
  "env": {
    "node": true,
    "es2021": true
  },
  "extends": ["eslint:recommended", "plugin:import/typescript", "prettier"],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "rules": {
    "import/no-unresolved": "error",
    "import/order": ["error", {
      "alphabetize": {"order": "asc", "caseInsensitive": true},
      "newlines-between": "always"
    }]
  }
}
